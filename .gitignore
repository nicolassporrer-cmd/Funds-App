# Credentials
.env
*.env.local

# Node / npm
node_modules/

# Build output
dist/

# Generated files — never edit directly
*.local.html

# Session data
payloads/
transcripts/

# Raw page caches — re-fetchable, and fund sites are large
data/raw/

# Pipeline intermediates. Every stage regenerates these from scratch, so
# committing them would add churn forever. Only the assembled payload and the
# hand-curated or expensive-to-rebuild files below are tracked.
data/portfolios.json
data/events.json
data/rounds.json
data/prospects.json

# TRACKED on purpose, do NOT add here:
#   data/funds.json      hand-curated fund list
#   data/contacts.json   hand-curated fund contacts. The pipeline only ever
#                        reads this file; no public source can regenerate it,
#                        so losing it would lose your own work.
#   data/siren-map.json  name -> SIREN cache; costs ~3,700 API calls to rebuild
#                        and carries manual corrections that must survive a refresh
#   data/payload.json    what the site builds from
#   plans/               part of the rebuild spec (see JOURNAL.md)

# Claude local settings
.claude/settings.local.json
.claude/last_anchor_check
